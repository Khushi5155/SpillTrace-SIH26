# SpillTrace frontend environment variables
#
# VITE_API_BASE_URL must point to wherever the browser can reach the
# backend. Inside Docker, "localhost" from the browser's perspective
# is the user's own machine, NOT the backend container — so if the
# backend is published on the host at port 8000, this should still
# be http://localhost:8000 (because the browser runs on the host),
# not http://backend:8000 (that hostname only resolves inside the
# Docker network, not in the browser).
VITE_API_BASE_URL=http://localhost:8000

# Optional future integrations (leave blank until backend exposes these endpoints)
# Full URL or path template; use {spillId} for the current investigation id.
VITE_AIS_TRACKS_URL=
VITE_CANDIDATES_URL=
